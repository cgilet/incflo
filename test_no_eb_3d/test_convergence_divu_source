#!/bin/bash
# Convergence of the div(u) = S manufactured solution with walls (inputs.divu_source_mms,
# incflo.probtype = 604), with dx and dt refined together (dt = dx/2).  Run from this
# directory after building incflo3d.gnu.MPI.ex.  The errors of u, v and w are second order.
# The pressure is first order next to the no-slip walls (see the inputs file).
for n in 16 32 64; do
    dt=$(awk "BEGIN {printf \"%.10g\", 0.5/$n}")
    ./incflo3d.gnu.MPI.ex inputs.divu_source_mms amr.n_cell="$n $n $n" incflo.fixed_dt=$dt >& out.mms.$n
done
echo "Norm0 / Norm2 of the errors at the final time"
for n in 16 32 64; do
    echo "probtype 604, n = $n"
    grep Norm0 out.mms.$n | tail -4
done
