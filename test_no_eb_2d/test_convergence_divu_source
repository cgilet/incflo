#!/bin/bash
# Convergence of the div(u) = S tests that have exact solutions, with dx and dt refined
# together (dt = dx/2).  Run from this directory after building incflo2d.gnu.MPI.ex.
#   inputs.divu_source_channel_unsteady (incflo.probtype = 603): u is exact to rounding
#     error.  The errors of the density and the tracer are first order in the max norm, in
#     the outflow boundary cells, and so about order 1.5 in L2.  Away from the outflow and
#     in L1 (not printed) they are second order, apart from the max error of the tracer,
#     which the PPM limiter slows down at the smooth maximum of rho s.
#   inputs.divu_source_mms (incflo.probtype = 604): the errors of u and v are second order.
#     The pressure is first order next to the no-slip walls (see the inputs file).
for n in 32 64 128 256; do
    dt=$(awk "BEGIN {printf \"%.10g\", 0.5/$n}")
    ./incflo2d.gnu.MPI.ex inputs.divu_source_channel_unsteady amr.n_cell="$n $((n/2))" incflo.fixed_dt=$dt >& out.channel.$n
    ./incflo2d.gnu.MPI.ex inputs.divu_source_mms amr.n_cell="$n $n" incflo.fixed_dt=$dt >& out.mms.$n
done
echo "Norm0 / Norm2 of the errors at the final time"
for n in 32 64 128 256; do
    echo "probtype 603, n = $n"
    grep Norm0 out.channel.$n | tail -4
done
for n in 32 64 128 256; do
    echo "probtype 604, n = $n"
    grep Norm0 out.mms.$n | tail -3
done
