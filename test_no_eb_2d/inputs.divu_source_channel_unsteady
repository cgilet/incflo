# div(u) = S with uniform S = 1 + sin(2 pi t)/2 (incflo.probtype = 603) in a channel with
# pressure outflow at both ends.  S stays positive, so both ends are always outflow.  The
# exact solution (src/prob/prob_divu_channel.H) has u = S(t) (x - 1/2), v = 0, and a
# density and a tracer that start as smooth profiles in x and are stretched by the flow.
# error_u, error_v, error_density and error_tracer hold the differences from it.
#
# mu = 0: the exact solution does not depend on mu, but the outflow velocity BC sets
# du/dx = 0 at the boundary while the exact solution has du/dx = S.  With mu > 0 that
# puts a force of about (4/3) mu S / dx in the boundary cells, and the pressure jumps
# by about (4/3) mu S at the boundary (the velocity is not affected here).

stop_time               =   0.5
max_step                =   -1

incflo.cfl              =   0.5
incflo.init_shrink      =   1.0

amr.plot_int            =   100000
amr.check_int           =   -1
amr.plotVariables       =   velx vely gpx density tracer divu_source error_u error_v error_density error_tracer

incflo.use_divu_source  =   1

incflo.constant_density =   0
incflo.ro_0             =   1.
incflo.mu               =   0.
incflo.gravity          =   0.  0.

incflo.advect_tracer    =   1

amr.n_cell              =   32  16
amr.max_level           =   0

geometry.prob_lo        =   0.  0.
geometry.prob_hi        =   1.  0.5
geometry.is_periodic    =   0   1

xlo.type                =   "po"
xlo.pressure            =   0.
xhi.type                =   "po"
xhi.pressure            =   0.

incflo.probtype         =   603

incflo.verbose          =   1
