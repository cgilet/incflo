# div(u) = S: steady manufactured solution (incflo.probtype = 604, src/prob/prob_divu_mms.H)
# in a box with no-slip walls, adapted from Bouloumou et al., Computers and Fluids 66
# (2012) 107-120.  The velocity vanishes on the walls, S = div(u) is not zero inside, and a
# velocity forcing makes u and p a steady solution.  The run starts from the exact
# velocity; error_u, error_v and error_p hold the differences from the exact solution.
#
# The density is constant, so incflo warns that mass is not conserved (S is a volume
# source here).  The forcing assumes the tensor viscous stress (incflo.use_tensor_solve).
#
# The velocity converges at second order.  The pressure is first order in the cells next to
# the walls, as in any viscous flow whose shear varies along a no-slip wall, with S = 0 too:
# the nodal projection leaves an O(h^2) error in the wall-normal velocity there, which the
# viscous operator turns into an O(1) wall-normal force that the pressure absorbs (see the
# docs).  tensor_diffusion.mg_maxorder = 3 below makes that pressure error a third smaller.

stop_time               =   1.0
max_step                =   -1

incflo.cfl              =   0.5
incflo.init_shrink      =   1.0

amr.plot_int            =   100000
amr.check_int           =   -1
amr.plotVariables       =   velx vely gpx gpy p divu_source error_u error_v error_p

incflo.use_divu_source  =   1

incflo.constant_density =   1
incflo.ro_0             =   1.
incflo.mu               =   0.05
incflo.diffusion_type   =   1
# Quadratic ghost-cell extrapolation at the walls in the viscous solves, which makes their
# truncation error there first order instead of O(1) (see the docs on the pressure at walls)
tensor_diffusion.mg_maxorder = 3
scalar_diffusion.mg_maxorder = 3
incflo.gravity          =   0.  0.
incflo.advect_tracer    =   0

amr.n_cell              =   32  32
amr.max_level           =   0

geometry.prob_lo        =   -0.5 -0.5
geometry.prob_hi        =    0.5  0.5
geometry.is_periodic    =   0   0

xlo.type                =   "nsw"
xhi.type                =   "nsw"
ylo.type                =   "nsw"
yhi.type                =   "nsw"

incflo.probtype         =   604

incflo.verbose          =   1
